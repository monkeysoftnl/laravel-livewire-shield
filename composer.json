{
    "name": "monkeysoftnl/laravel-livewire-shield",
    "description": "Security and exception-handling layer for Livewire: quiet responses for tampered or oversized payloads, structured logging and per-address limits.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^3.8.3|^4.4.8"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "MonkeySoft\\LivewireShield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonkeySoft\\LivewireShield\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MonkeySoft\\LivewireShield\\LivewireShieldServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    }
}
