{
    "name": "monkeysoftnl/laravel-livewire-shield",
    "description": "Turns tampered Livewire payloads into a quiet 403, a log line and a per-address limit.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "MonkeySoft\\LivewireShield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonkeySoft\\LivewireShield\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MonkeySoft\\LivewireShield\\LivewireShieldServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest"
    }
}
